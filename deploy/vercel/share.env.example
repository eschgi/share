# Share's settings on Vercel, one variable each: paste them into the project's Environment
# Variables and put in your own values. Each is a setting of config.json (README, Configuration).
# The quotes keep the shell from reading the & when the file is loaded with ". ./share.env".
SHARE_PUBLIC_URL=https://share.example.com
SHARE_TIME_ZONE=Europe/Rome
SHARE_PROXY=x-forwarded
SHARE_DATABASE_POSTGRES="postgres://share:PASSWORD@ep-example-123456.eu-central-1.aws.neon.tech/share?sslmode=require&channel_binding=require"
SHARE_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
SHARE_S3_REGION=auto
SHARE_S3_BUCKET=family-share
SHARE_S3_ACCESS_KEY_ID=…
SHARE_S3_SECRET_ACCESS_KEY=…
