#!/bin/sh /etc/rc.common
# procd service for Share on OpenWrt: runs /root/share/share with /root/share/config.json.

START=99
STOP=10

USE_PROCD=1
PROG=/root/share/share
CONFIG=/root/share/config.json

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" serve --config "$CONFIG"
	# Keeps the Go heap small next to everything else the router runs.
	procd_set_param env GOMEMLIMIT=256MiB
	# Restart 5 s after a crash, without giving up.
	procd_set_param respawn 3600 5 0
	# The server takes up to 20 s to let running requests finish.
	procd_set_param term_timeout 25
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
