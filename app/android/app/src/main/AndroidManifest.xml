<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The Flutter template puts INTERNET only in the debug and profile manifests. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- RouteMonitor looks at the local address again when the network changes. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The downloads' progress and summary (Android 13+ asks when the first one starts). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 14+: downloads run as user-initiated data transfer jobs. -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <!-- Android 10 to 13: a WorkManager worker in the foreground instead. FOREGROUND_SERVICE
         itself is merged in by androidx.work. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- usesCleartextTraffic: plain http to a server or a bucket at home. Android can't tell
         addresses at home from others, so the app checks that itself and refuses http:// for
         any other (isHomeHost in lib/data/server.dart and net/HomeHosts.kt). -->
    <application
        android:label="@string/app_name"
        android:name=".ShareApplication"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Links reach the app through the platform channel, not Flutter's router. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- The invite page's "Join" hands the invite over as
                 com.eschgi.share://join?server=…&token=… (app.link_scheme on the server). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${linkScheme}" android:host="join" />
            </intent-filter>
            <!-- "Send with Share" in other apps' share sheets: files, and texts with a Share link
                 in them (Outbox.kt). -->
            <intent-filter android:label="@string/send_with_share">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Android 14+: the host of downloads and uploads. Only the system binds it, and it is only ever
             scheduled from Android 14 on. -->
        <service
            android:name=".transfer.TransferJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false"
            tools:ignore="NewApi" />

        <!-- WorkManager is set up by ShareApplication instead, with job ids that stay clear of
             DownloadJobService's. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- androidx.work declares this service without a foregroundServiceType, and starting
             a foreground service with a type the manifest doesn't declare throws. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- The notification's Cancel. Not exported: only our own PendingIntent fires it. -->
        <receiver
            android:name=".transfer.TransferReceiver"
            android:exported="false" />

        <!-- Files fetched into the cache, handed to other apps for sharing or opening. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Google's code scanner (Scanner.kt) comes with Google Play services: installed from the
             Play Store, its module is fetched with the app, not at the first scan. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
