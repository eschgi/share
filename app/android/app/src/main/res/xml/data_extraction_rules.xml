<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: the phone's key is encrypted with a KeyStore key that stays
     here anyway, and the download queue points at this phone's files. allowBackup="false"
     covers cloud backups; these rules cover transfers to a new phone (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
