<?xml version="1.0" encoding="utf-8"?>
<!-- Files fetched for sharing with another app or opening in one (Fetcher.kt), copies of files
     shared into the app until they are sent (Outbox.kt), and ZIPs packed for other apps
     (ZipSending.kt). -->
<paths>
    <cache-path name="fetch" path="fetch/" />
    <files-path name="outbox" path="outbox/" />
    <files-path name="zips" path="zips/" />
</paths>
